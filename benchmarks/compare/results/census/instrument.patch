+// Census instrumentation. Off unless `globalThis.__forgettiCensus` is set, and then it only
+// records. A relax key turns one refusal off, to measure what it costs. Not for release.
+import type { AstNode } from '../emit/ast';
+import { isNode } from '../emit/ast';
+import type { Range } from '../ir';
+import type { Context } from './baseline';
+import {
+  STABLE_GLOBALS,
+  explainImpureSyntax,
+  explainLocal,
+  getRange,
+  isInside,
+  isPlainInput,
+} from './baseline';
+
+export interface CensusRecord {
+  /** The planner site that refused: `groups.findCandidate`, `loops.mapSite`, ... */
+  site: string;
+  /** The reason, such as `outer_binding_unstable`. */
+  code: string;
+  /** The finer reason: why the binding or use failed. */
+  sub?: string;
+  /** The binding that failed, by name. */
+  binding?: string;
+  /** The range of the use or node that failed. */
+  use?: Range;
+  /** The range of the refused expression, element or statement. */
+  range: Range;
+  file?: string;
+  unit?: string;
+}
+
+export interface CensusSink {
+  file?: string;
+  unit?: string;
+  records: CensusRecord[];
+  /** Relax keys: a refusal whose key or a prefix of it is listed is not made. */
+  relax: Set<string>;
+}
+
+export function getCensus(): CensusSink | undefined {
+  return (globalThis as { __forgettiCensus?: CensusSink }).__forgettiCensus;
+}
+
+export function isCensusOn(): boolean {
+  return getCensus() !== undefined;
+}
+
+/** True when the key, or any `:`-prefix of it, is a relax key. */
+export function isRelaxed(key: string): boolean {
+  const census = getCensus();
+  if (!census || census.relax.size === 0) {
+    return false;
+  }
+  const parts = key.split(':');
+  for (let length = parts.length; length > 0; length--) {
+    if (census.relax.has(parts.slice(0, length).join(':'))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * Why a conditional or a `.map` receiver may not move before its statement: impure syntax,
+ * a changing global, or the first binding that is not a plain input.
+ */
+export function explainHoist(
+  ctx: Context,
+  node: AstNode,
+  atStart: number,
+): Pick<CensusRecord, 'sub' | 'binding' | 'use'> {
+  const range = getRange(node);
+  const impure = explainImpureSyntax(ctx, node);
+  if (impure) {
+    return { sub: `impure_syntax:${impure.sub}`, use: impure.use };
+  }
+  for (const reference of ctx.globals) {
+    const target: unknown = reference.node;
+    const name = isNode(target) && typeof target.name === 'string' ? target.name : '?';
+    if (isInside(reference.range, range) && !STABLE_GLOBALS.has(name)) {
+      return { sub: `global:${name}`, use: reference.range };
+    }
+  }
+  for (const { reference, binding } of ctx.refs) {
+    if (
+      isInside(reference.range, range) &&
+      !isInside(binding.declaration, range) &&
+      !isPlainInput(ctx, binding, atStart)
+    ) {
+      return {
+        sub: `binding:${explainLocal(ctx, binding, atStart)}`,
+        binding: binding.name,
+        use: reference.range,
+      };
+    }
+  }
+  return { sub: 'unknown' };
+}
+
+export function recordRefusal(record: Omit<CensusRecord, 'file' | 'unit'>): void {
+  const census = getCensus();
+  if (census) {
+    census.records.push({ ...record, file: census.file, unit: census.unit });
+  }
+}
