{
  "name": "forgetti",
  "version": "0.8.6",
  "description": "Solve your hook spaghetti. Inspired by React Forget",
  "keywords": [
    "babel",
    "compiler",
    "memoization",
    "preact",
    "react"
  ],
  "homepage": "https://github.com/lxsmnsyc/forgetti/tree/main/packages/forgetti",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/forgetti/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/forgetti.git"
  },
  "files": [
    "dist",
    "src",
    "runtime"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./runtime": {
      "development": {
        "import": {
          "types": "./dist/runtime.d.ts",
          "default": "./dist/development/runtime.js"
        },
        "require": {
          "types": "./dist/runtime.d.cts",
          "default": "./dist/development/runtime.cjs"
        }
      },
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      },
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "optimize": "node example > output.js"
  },
  "dependencies": {
    "@babel/traverse": "^7.23.2",
    "@babel/types": "^7.23.0",
    "magic-string": "1.4.5",
    "oxc-parser": "0.159.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "preact": "11.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@babel/core": "^7"
  },
  "engines": {
    "node": ">=10"
  }
}
