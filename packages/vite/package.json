{
  "name": "vite-plugin-forgetti",
  "version": "0.8.6",
  "description": "Solve your hook spaghetti. Inspired by React Forget",
  "keywords": [
    "babel",
    "compiler",
    "memoization",
    "preact",
    "react"
  ],
  "homepage": "https://github.com/lxsmnsyc/forgetti/tree/main/packages/vite",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/forgetti/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/forgetti.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.23.7",
    "@rollup/pluginutils": "^5.0.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "forgetti": "workspace:*",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^5.0.11"
  },
  "peerDependencies": {
    "forgetti": "^0.8.6",
    "vite": "^3 || ^4 || ^5"
  },
  "engines": {
    "node": ">=10"
  }
}
