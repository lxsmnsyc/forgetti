{
  "exclude": ["node_modules"],
  "include": ["src", "types"],
  "compilerOptions": {
    "module": "preserve",
    "lib": ["ESNext", "DOM"],
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "target": "es2022",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  }
}
